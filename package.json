{
  "name": "@whzxc/agent-design-gallery",
  "version": "0.10.0",
  "description": "Local TSX design toolkit and SVG viewer",
  "type": "module",
  "license": "MIT",
  "bin": {
    "adg": "src/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "public",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whzxc/agent-design-gallery.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "benchmark": "node tooling/benchmark.mjs",
    "compare": "node tooling/compare.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node tooling/package.mjs"
  },
  "dependencies": {
    "css-tree": "3.1.0",
    "entities": "9.0.0",
    "esbuild": "0.28.2",
    "lucide": "1.70.0",
    "parse5": "8.1.1",
    "pele": "1.12.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.4"
  },
  "homepage": "https://github.com/whzxc/agent-design-gallery#readme",
  "bugs": {
    "url": "https://github.com/whzxc/agent-design-gallery/issues"
  }
}
